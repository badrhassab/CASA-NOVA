# Groq / Grok Cloud API (Free & blazing fast - recommended!)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Or xAI Grok API:
# XAI_API_KEY=your-xai-api-key-here
# XAI_MODEL=grok-2-latest

# Local Ollama settings (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Chroma vector store (local)
ASSISTRONAUT_CHROMA_DIR=./assistronaut_chroma_db

# Supabase (server only — use the service role key, never expose it in React)
# Project URL looks like https://xxxx.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-service-role-key
