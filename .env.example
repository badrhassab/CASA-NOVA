# ============================================================
# Assistronaut – Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
# ============================================================

# ----------------------------------------------------------
# Groq Cloud API  (required – get a free key at console.groq.com)
# ----------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here

# Confirmed working models on the free tier (try in this order):
#   openai/gpt-oss-120b   ← recommended (best quality)
#   openai/gpt-oss-20b    ← faster / lighter
#   qwen/qwen3.8-27b      ← multilingual fallback
GROQ_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------
# Supabase  (server-side only – use the service role key)
# ----------------------------------------------------------
# Your project URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key (Settings → API → service_role) – never expose in React
SUPABASE_KEY=your-service-role-key

# ----------------------------------------------------------
# Optional: local Ollama fallback (leave as-is if not using)
# ----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# ----------------------------------------------------------
# Chroma vector store (local path, relative to backend/)
# ----------------------------------------------------------
ASSISTRONAUT_CHROMA_DIR=./assistronaut_chroma_db
